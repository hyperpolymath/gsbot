# SPDX-License-Identifier: MPL-2.0
# GSBot — Garment Sustainability Bot
# Copy this file to `.env` and fill in the required values.
# https://github.com/hyperpolymath/gsbot

# ── Discord ──────────────────────────────────────────────────────────
# REQUIRED. Bot token from the Discord Developer Portal.
DISCORD_TOKEN=
# Command prefix (default "!").
DISCORD_PREFIX=!
# Comma-separated Discord user IDs allowed to run admin commands.
DISCORD_ADMIN_IDS=

# ── Database ─────────────────────────────────────────────────────────
# SQLite URL. Defaults to sqlite:///<cwd>/data/gsbot.db
DATABASE_URL=
# Echo SQL statements to the log (default false).
DATABASE_ECHO=false

# ── Caching ──────────────────────────────────────────────────────────
ENABLE_CACHING=true
CACHE_TTL=3600
CACHE_MAXSIZE=1000

# ── Logging ──────────────────────────────────────────────────────────
# TRACE | DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
# Optional file path for rolling log output (leave blank for stderr only).
LOG_FILE=

# ── HTTP ─────────────────────────────────────────────────────────────
API_TIMEOUT=30
API_RETRY_COUNT=3

# ── Telemetry ────────────────────────────────────────────────────────
ENABLE_ANALYTICS=false
