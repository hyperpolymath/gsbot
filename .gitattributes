# Auto-detect text files and perform LF normalization
* text=auto

# Denote all AsciiDoc files as text
*.adoc text
*.md text
*.asc text

# Denote all YAML files as text
*.yaml text
*.yml text

# kyaml files (hyperpolymath typed-YAML replacement)
*.kyaml text

# Denote all JSON files as text
*.json text

# Denote all TOML files as text
*.toml text

# Denote all JavaScript/TypeScript files as text
*.js text
*.ts text
*.jsx text
*.tsx text

# Denote all HTML files as text
*.html text

# Denote all CSS files as text
*.css text

# Denote all Rust files as text
*.rs text

# Denote all C/C++ files as text
*.c text
*.cpp text
*.h text
*.hpp text
*.cxx text

# Denote all Ada/SPARK files as text
*.adb text
*.ads text

# Denote all Zig files as text
*.zig text

# Denote all Eclexia files (piloted in this repo)
*.ecx text

# Line endings
*.sh eol=lf
*.adoc eol=lf
*.md eol=lf
*.yaml eol=lf
*.yml eol=lf
*.json eol=lf
*.toml eol=lf
*.rs eol=lf
*.zig eol=lf
*.adb eol=lf
*.ads eol=lf
*.ecx eol=lf
*.js eol=lf
*.ts eol=lf
Makefile eol=lf
Justfile eol=lf
Mustfile eol=lf
Dockerfile eol=lf
Containerfile eol=lf

# Language-specific attributes
*.rs diff=rust
*.zig diff=zig
*.adb diff=ada
*.ads diff=ada

# Linguist-specific overrides
*.ecx linguist-language=Eclexia
*.kyaml linguist-language=YAML
*.adb linguist-language=Ada
*.ads linguist-language=Ada
*.coq linguist-language=Coq
*.v linguist-language=V
*.agda linguist-language=Agda
*.idr linguist-language=Idris
